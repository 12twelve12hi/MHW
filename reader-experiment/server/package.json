{
  "name": "daylight-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Daylight server: a Cloudflare Worker for email-in, feeds and digests, large files and AI (see DESIGN.md)",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir .build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "vectors": "node vectors/generate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "postal-mime": "4.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "miniflare": "5.20261019.0-beta",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  }
}
