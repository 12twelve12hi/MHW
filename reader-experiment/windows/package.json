{
  "name": "send-to-daylight-windows",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Send to Daylight for Windows: a Tauri tray app that sends files and links to a Daylight DC-1",
  "scripts": {
    "build:frontend": "node build.mjs",
    "test": "node build.mjs && node --test test/unit/*.test.mjs",
    "tauri": "tauri",
    "build": "tauri build --bundles nsis",
    "e2e": "node test/e2e/windows.e2e.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
