{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Send to Daylight",
  "mainBinaryName": "send-to-daylight",
  "version": "1.0.0",
  "identifier": "com.daylight.share.windows",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Send to Daylight",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "maximizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Daylight reader experiment",
    "shortDescription": "Send files and links to your Daylight DC-1",
    "longDescription": "A notification-area app that sends files and web links from this PC to a Daylight DC-1, end-to-end encrypted, through a free ntfy relay.",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["daylightshare"] }
    }
  }
}
