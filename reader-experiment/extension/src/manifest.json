{
  "manifest_version": 3,
  "name": "Send to Daylight",
  "short_name": "To Daylight",
  "version": "1.1.0",
  "description": "Send web pages, links and PDFs to your Daylight DC-1. End-to-end encrypted, no account.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send to Daylight",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "https://ntfy.sh/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Send this page to Daylight"
    },
    "send-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Send selection to Daylight"
    },
    "send-clean": {
      "description": "Send clean article to Daylight"
    },
    "send-link": {
      "description": "Send link to Daylight"
    }
  },
  "omnibox": {
    "keyword": "dl"
  },
  "minimum_chrome_version": "116"
}
