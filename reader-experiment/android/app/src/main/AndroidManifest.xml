<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Inbox: "Display over other apps" lets it hand items to the Reader while another app is in front, and show the
         card for documents that wait for a tap over the Reader. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Inbox, Instant delivery: asks to be left out of battery optimisation so Doze does not cut the connection. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Sender: scanning the pairing QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- The apps the Inbox hands items to: the Daylight Reader builds (com.daylightcomputer.reader and suffixed copies),
         the lab's side-by-side copy, and any app that takes SAVE_PAGE or shared documents ("Deliver to"). -->
    <queries>
        <package android:name="com.daylightcomputer.reader" />
        <package android:name="com.daylightcomputer.readerexperiment" />
        <intent>
            <action android:name="com.daylightcomputer.reader.action.SAVE_PAGE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="daylightreader" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="*/*" />
        </intent>
        <!-- Lab: K6 (LAB-PLAN 5.3.4): the Lab Reader's built-in inbox (its package is listed above), which the Inbox asks
             "receiving" before each would-be poll while the Lab Reader receives for this Daylight. -->
        <provider android:authorities="com.daylightcomputer.readerexperiment.shareinbox" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.DaylightShare"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- daylightshare://pair?c=... from the Daylight's QR code (PROTOCOL 1.3); daylightshare://setup in debug builds. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daylightshare" />
            </intent-filter>
            <!-- Lab: K4 (F08): the Direct Share target, your Daylight in the share sheet's top row. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The share target: small and translucent, finishes as soon as the item is on its way. -->
        <activity
            android:name=".sender.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:taskAffinity="com.daylight.share.send"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.DaylightShare.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Lab: K4 (F09): other apps and scripts send a link (com.daylight.share.action.SEND_URL; daylightshare://send
             comes here through MainActivity). It asks first, unless quick sends are allowed in Lab settings. -->
        <activity
            android:name=".sender.AutomationActivity"
            android:exported="true"
            android:label="@string/automation_label"
            android:excludeFromRecents="true"
            android:taskAffinity="com.daylight.share.send"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.DaylightShare.Translucent">
            <intent-filter>
                <action android:name="com.daylight.share.action.SEND_URL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Inbox: hands waiting items to the Reader one by one (it needs an activity to read SAVE_PAGE's result). -->
        <activity
            android:name=".inbox.HandoffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.daylight.share.handoff"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.DaylightShare.Translucent" />

        <!-- The scanner in portrait as well as landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <service
            android:name=".inbox.InstantDeliveryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection to the user's ntfy relay open so items shared from the user's phone reach this tablet at once." />
        </service>

        <!-- Inbox: an item's notification swiped away (it is not announced again). -->
        <receiver
            android:name=".inbox.NoticeDismissedReceiver"
            android:exported="false" />

        <!-- Lab: K5 (F15): Keep for later on a waiting item's notice, Dismiss on "Saved to the Reader", and Turn on on
             "Instant delivery stopped". -->
        <receiver
            android:name=".inbox.ArrivalActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".inbox.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lab: K6 (LAB-PLAN 5.3.4): hands the Inbox's pairing to the Lab Reader (com.daylightcomputer.readerexperiment),
             only while "Let Daylight Reader (lab) receive" is armed and only to that package; it answers nothing else. -->
        <provider
            android:name=".inbox.handover.HandoverProvider"
            android:authorities="${applicationId}.handover"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
